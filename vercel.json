{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "error",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "LARAVEL_STORAGE_PATH": "/tmp/storage"
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/profile-cover-rizky.jpg", "dest": "/profile-cover-rizky.jpg" },
    { "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2))", "dest": "/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.php?__laravel_path=/api/$1" },
    { "src": "/broadcasting/auth", "dest": "/api/index.php?__laravel_path=/broadcasting/auth" },
    { "src": "/sanctum/(.*)", "dest": "/api/index.php?__laravel_path=/sanctum/$1" },
    { "src": "/up", "dest": "/api/index.php?__laravel_path=/up" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
